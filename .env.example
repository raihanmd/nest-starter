# =============================================================================
# NestJS Starter - Environment Configuration
# =============================================================================
# This file documents all environment variables needed by the application.
# Copy this file to .env and fill in your values.
#
# Usage:
#   cp .env.example .env
#   cp .env.test.example .env.test  # For E2E tests
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database?schema=public
DATABASE_URL=postgres://postgres:root@localhost:5435/nest_starter?schema=public

# Test Database (used when NODE_ENV=test)
# Create separate database for E2E tests to avoid data corruption
DATABASE_URL_TEST=postgres://postgres:root@localhost:5435/nest_starter_test?schema=public

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port number for the application server
SERVER_PORT=3000

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Secret key for JWT token signing
# IMPORTANT: Change this in production! Use a strong, random string.
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# =============================================================================
# API SECURITY
# =============================================================================
# API Key for additional endpoint protection (via middleware)
# IMPORTANT: Change this in production!
API_KEY=your-api-key-change-in-production

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Whitelist of allowed origins for CORS (comma-separated)
# Use '*' to allow all origins (not recommended for production)
# CORS_ORIGINS=http://localhost:3005,http://localhost:3000
